# El Reto — variables de entorno (EJEMPLO). Copiar a .env y completar.
# NUNCA poner secretos reales en este archivo ni en el repositorio.

# --- Base de datos ---
POSTGRES_USER=elreto
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=elreto
DATABASE_URL=postgres://elreto:cambia_esta_clave@postgres:5432/elreto

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- API (NestJS) ---
API_PORT=4000
API_URL=http://localhost:4000
JWT_ACCESS_SECRET=cambia_este_secreto_access_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_largo_y_aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Correo (opcional en desarrollo; sin SMTP se registra el enlace en el log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@elreto.local

# --- Billetera DEMO (créditos virtuales, sin valor real) ---
DEMO_WELCOME_CREDITS=1000
DEMO_DAILY_DEPOSIT_LIMIT=10000
DEMO_MAX_STAKE=1000

# --- Juego ---
MOVE_TIMEOUT_SECONDS=30
CHALLENGE_TTL_HOURS=24

# --- OAuth: entrar con Gmail o Facebook (opcional; sin credenciales los
# endpoints /auth/google y /auth/facebook responden 503 OAUTH_NOT_CONFIGURED
# y la aplicación arranca igual). Pedir las credenciales en la consola de
# Google Cloud (OAuth 2.0) y en Meta for Developers (Facebook Login).
# NUNCA poner secretos reales en este archivo ni en el repositorio.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback
